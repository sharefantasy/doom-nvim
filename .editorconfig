# Doom Nvim EditorConfig
# 基于 AGENTS.md 中的代码规范配置

# 根目录配置
root = true

# 通用配置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Lua 文件配置 - AGENTS.md 规范：2空格缩进，120字符行宽，优先双引号
[*.lua]
indent_style = space
indent_size = 2
max_line_length = 120
quote_type = double

# Fennel 文件配置 - AGENTS.md 规范：2空格缩进，120字符行宽
[*.fnl]
indent_style = space
indent_size = 2
max_line_length = 120

# Markdown 文件配置 - 保留行尾空格用于换行
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# JSON/YAML/TOML 配置文件
[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

# Shell 脚本
[*.sh]
indent_style = space
indent_size = 2

# Vim 配置文件
[*.vim]
indent_style = space
indent_size = 2

# Git 提交文件
[COMMIT_EDITMSG]
max_line_length = off
