layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    tab name="agent" focus=true {
        pane command="traex" focus=true
    }

    tab name="tools" {
        pane stacked=true {
            pane name="tlc" focus=true
            pane name="shell"
            pane command="lazygit" name="git"
        }
    }

    tab name="logs" {
        pane command="zsh" {
            args "-lc" "exec tail -F \"$HOME/.local/state/nvim/lsp.log\""
        }
    }
}
