;; doom.modules.core.doom
;; Core doom module - essential functionality

(local doom {})

(doom.packages [])
(doom.configs {})
(doom.settings {})
(doom.autocmds [])
(doom.cmds [])
(doom.binds [])

;; Core functionality is already handled by doom.core modules
